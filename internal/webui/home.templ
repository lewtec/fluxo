package webui

templ HomePage(stats SpeedStats, torrents []TorrentView) {
	@Chrome("Fluxo", stats) {
		@TorrentList(torrents)
	}
}

templ TorrentList(torrents []TorrentView) {
	<div id="torrent-list" class="overflow-x-auto">
		<table class="table table-sm table-pin-rows">
			<thead>
				<tr>
					<th>Name</th>
					<th>Status</th>
					<th>Size</th>
					<th class="hidden sm:table-cell">Done</th>
					<th>↓</th>
					<th>↑</th>
					<th class="hidden md:table-cell">ETA</th>
					<th>Peers</th>
				</tr>
			</thead>
			<tbody>
				if len(torrents) == 0 {
					<tr>
						<td colspan="8">
							No torrents. <a href="/add" class="link">Add</a>
						</td>
					</tr>
				} else {
					for _, t := range torrents {
						@TorrentRow(t)
					}
				}
			</tbody>
		</table>
	</div>
}

templ TorrentRow(t TorrentView) {
	<tr class="hover">
		<td class="max-w-64 sm:max-w-md">
			<a href={ templ.SafeURL("/torrents/" + t.ID) } class="link" title={ t.Name }>{ t.Name }</a>
			<progress class={ "progress h-1 w-full mt-1", t.ProgressClass } value={ formatProgress(t.Progress) } max="100"></progress>
		</td>
		<td class={ t.StatusClass }>{ t.StatusCode }</td>
		<td class="whitespace-nowrap">{ t.BytesTotal }</td>
		<td class="hidden sm:table-cell whitespace-nowrap">{ formatProgress(t.Progress) }%</td>
		<td class="whitespace-nowrap text-success">{ t.DownloadSpeed }</td>
		<td class="whitespace-nowrap">{ t.UploadSpeed }</td>
		<td class="hidden md:table-cell whitespace-nowrap">{ t.ETA }</td>
		<td>{ fmtInt(t.PeersTotal) }</td>
	</tr>
}

templ NotFoundPage(stats SpeedStats) {
	@Chrome("Torrent not found — Fluxo", stats) {
		<div role="alert" class="alert alert-error">
			<span>Torrent not found.</span>
			<a href="/" class="link">Back</a>
		</div>
	}
}
