package webui

templ TorrentPage(stats SpeedStats, t TorrentView) {
	@Chrome(t.Name+" — Fluxo", stats) {
		@TorrentDetail(t)
	}
}

templ TorrentDetail(t TorrentView) {
	<div id="torrent-detail" data-id={ t.ID } class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<a href="/" class="link">← list</a>
			<div id="torrent-detail-actions" class="flex gap-3">
				if t.Stopped {
					<form method="post" action={ templ.SafeURL("/torrents/" + t.ID + "/start") }>
						<button type="submit" class="link">Start</button>
					</form>
				} else {
					<form method="post" action={ templ.SafeURL("/torrents/" + t.ID + "/stop") }>
						<button type="submit" class="link">Stop</button>
					</form>
				}
				<form method="post" action={ templ.SafeURL("/torrents/" + t.ID + "/remove") } onsubmit="return confirm('Remove this torrent?')">
					<button type="submit" class="link text-error">Remove</button>
				</form>
			</div>
		</div>
		<div id="torrent-detail-summary">
			<h1 class="text-lg font-bold break-all mb-2">{ t.Name }</h1>
			<div class="overflow-x-auto">
				<table class="table table-sm">
					<tbody>
						<tr>
							<th class="w-32">Status</th>
							<td class={ t.StatusClass }>{ t.StatusCode } — { t.Status }</td>
						</tr>
						<tr>
							<th>Size</th>
							<td>{ t.BytesDone } / { t.BytesTotal } ({ formatProgress(t.Progress) }%)</td>
						</tr>
						<tr>
							<th></th>
							<td>
								<progress class={ "progress w-full max-w-md", t.ProgressClass } value={ formatProgress(t.Progress) } max="100"></progress>
							</td>
						</tr>
						<tr>
							<th>↓ / ↑</th>
							<td class="tabular-nums">{ t.DownloadSpeed } / { t.UploadSpeed }</td>
						</tr>
						<tr>
							<th>Peers</th>
							<td>{ fmtInt(t.PeersTotal) } ({ fmtInt(t.PeersIn) } in / { fmtInt(t.PeersOut) } out)</td>
						</tr>
						<tr>
							<th>ETA</th>
							<td>{ t.ETA }</td>
						</tr>
						<tr>
							<th>Hash</th>
							<td class="font-mono text-xs break-all">{ t.InfoHash }</td>
						</tr>
						<tr>
							<th>Added</th>
							<td>{ t.AddedAt }</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
		<div class="collapse collapse-arrow border border-base-300">
			<input id="torrent-files-open" type="checkbox"/>
			<div id="torrent-files-title" class="collapse-title font-bold">
				Files ({ fmtInt(len(t.Files)) })
			</div>
			<div class="collapse-content">
				<div class="overflow-x-auto">
					<table class="table table-xs">
						<thead>
							<tr>
								<th>Path</th>
								<th>Size</th>
								<th>Done</th>
							</tr>
						</thead>
						<tbody id="torrent-files-body">
							for _, f := range t.Files {
								<tr>
									<td class="break-all">{ f.Path }</td>
									<td class="whitespace-nowrap">{ f.Size }</td>
									<td class="w-28">
										<progress class="progress progress-xs w-full" value={ formatProgress(f.Progress) } max="100"></progress>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div class="collapse collapse-arrow border border-base-300">
			<input id="torrent-trackers-open" type="checkbox"/>
			<div id="torrent-trackers-title" class="collapse-title font-bold">
				Trackers ({ fmtInt(len(t.Trackers)) })
			</div>
			<div class="collapse-content">
				<div class="overflow-x-auto">
					<table class="table table-xs">
						<thead>
							<tr>
								<th>URL</th>
								<th>Status</th>
							</tr>
						</thead>
						<tbody id="torrent-trackers-body">
							for _, tr := range t.Trackers {
								<tr>
									<td class="break-all">{ tr.URL }</td>
									<td>{ tr.Status }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
}
