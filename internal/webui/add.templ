package webui

templ AddTorrentPage(stats SpeedStats, page AddPage) {
	@Chrome("Add — Fluxo", stats) {
		<div class="max-w-xl">
			<p class="mb-3"><a href="/" class="link">← list</a></p>
			<h1 class="text-lg font-bold mb-4">Add</h1>
			<form method="post" action="/torrents" enctype="multipart/form-data" class="space-y-4">
				<fieldset class="fieldset">
					<legend class="fieldset-legend">Magnet URI</legend>
					<textarea
						name="uri"
						class="textarea font-mono text-xs w-full h-24"
						placeholder="magnet:?xt=urn:btih:..."
					>{ page.URI }</textarea>
				</fieldset>
				<fieldset class="fieldset">
					<legend class="fieldset-legend">or a .torrent file</legend>
					<input type="file" name="file" accept=".torrent" class="file-input w-full"/>
				</fieldset>
				if page.Error != "" {
					<div role="alert" class="alert alert-error text-sm">
						<span>{ page.Error }</span>
					</div>
				}
				<button type="submit" class="btn">Add</button>
			</form>
		</div>
	}
}
