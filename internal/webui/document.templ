package webui

templ Document(title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="bay">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script>
				(function () {
					var t;
					try { t = localStorage.getItem('fluxo-theme'); } catch (e) {}
					if (t === 'light') t = 'listing';
					if (t === 'dark') t = 'bay';
					if (t !== 'listing' && t !== 'bay') {
						t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) ? 'listing' : 'bay';
					}
					document.documentElement.setAttribute('data-theme', t);
				})();
			</script>
		</head>
		<body class="min-h-screen">
			<!--
THESIS: The transfer list is a classical torrent-site table: name, size, status, peers, live speeds. No ads, no cards.
OWN-WORLD: Black (bay) or pale listing paper; red wordmark; green seeds; Verdana; radius 0; daisyUI table/navbar/link.
STORY: See what is moving, how fast, act (add/start/stop) without leaving the list.
FIRST VIEWPORT: Thin header (Fluxo / rates / Add). Full-width table. Empty state is an empty table plus one line.
FORM: Bay Table (classical torrent index grammar). Seed d6e3be21, safer register, user steer.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->
			{ children... }
			<script src="/static/js/app.js" defer></script>
		</body>
	</html>
}

templ HeaderStats(stats SpeedStats) {
	<div id="header-stats" class="flex items-center gap-3 text-xs tabular-nums">
		<span class="text-success">↓ { formatSpeed(stats.Download) }</span>
		<span>↑ { formatSpeed(stats.Upload) }</span>
	</div>
}

templ Header(stats SpeedStats) {
	<div class="navbar min-h-10 px-3 border-b border-base-300">
		<div class="navbar-start">
			<a href="/" class="text-xl font-bold text-primary no-underline">Fluxo</a>
		</div>
		<div class="navbar-end gap-4">
			@HeaderStats(stats)
			<a href="/add" class="link">Add</a>
			<label class="swap swap-rotate">
				<input
					id="theme-toggle"
					type="checkbox"
					class="theme-controller"
					value="listing"
					aria-label="Switch theme"
				/>
				@iconSun()
				@iconMoon()
			</label>
		</div>
	</div>
}

templ Chrome(title string, stats SpeedStats) {
	@Document(title) {
		@Header(stats)
		<main class="p-3">
			{ children... }
		</main>
	}
}

templ iconSun() {
	<svg class="swap-on size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
}

templ iconMoon() {
	<svg class="swap-off size-4" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
}
